{
  "name": "apppilot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @apppilot/web",
    "build:web": "npm run build --workspace @apppilot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:web:mock": "npm run dev:mock --workspace @apppilot/web"
  },
  "engines": {
    "node": ">=20.9"
  }
}
